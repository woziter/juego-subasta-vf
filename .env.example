# Para desarrollo local sin certificados, dejá estas variables vacías.
# Con certificado TLS instalado, el servidor escucha por HTTPS (puerto 3443 por defecto).
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
PORT=
# Herramientas de desarrollo: bots y controles para probar subastas/peritajes.
# Mantener desactivado en servidores públicos o de producción.
ENABLE_DEV_TOOLS=false
